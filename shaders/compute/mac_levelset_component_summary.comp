#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer LabelBuffer { uint label[]; };
layout(std430, binding = 1) buffer DiagnosticBuffer { uint diagnostic[]; };
uniform uint elementCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= elementCount) return;
    if (label[i] == i + 1u) atomicAdd(diagnostic[13], 1u);
}
