#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 4) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 5) readonly buffer DivergenceBuffer { float divergence[]; };
layout(std430, binding = 6) writeonly buffer PartialBuffer { dvec4 partial[]; };

uniform uint elementCount;

shared double sumAbsolute[256];
shared double maximumAbsolute[256];
shared double validCount[256];

const uint FLUID = 0u;

void main() {
    const uint localIndex = gl_LocalInvocationID.x;
    const uint index = gl_GlobalInvocationID.x;
    const bool valid = index < elementCount && cellType[index] == FLUID;
    const double magnitude = valid ? abs(double(divergence[index])) : 0.0;
    sumAbsolute[localIndex] = magnitude;
    maximumAbsolute[localIndex] = magnitude;
    validCount[localIndex] = valid ? 1.0 : 0.0;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            sumAbsolute[localIndex] += sumAbsolute[localIndex + stride];
            maximumAbsolute[localIndex] = max(
                maximumAbsolute[localIndex], maximumAbsolute[localIndex + stride]);
            validCount[localIndex] += validCount[localIndex + stride];
        }
        barrier();
    }
    if (localIndex == 0u) {
        partial[gl_WorkGroupID.x] = dvec4(
            sumAbsolute[0], maximumAbsolute[0], validCount[0], 0.0);
    }
}
