#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer CellTypes { uint cellType[]; };
layout(std430, binding = 1) readonly buffer Labels { uint labels[]; };
layout(std430, binding = 2) buffer ComponentFlags { uint componentFlags[]; };
uniform uvec2 gridSize;
const uint FLUID = 0u;
const uint AIR = 1u;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= gridSize.x * gridSize.y || cellType[index] != FLUID) return;
    const uint x = index % gridSize.x;
    const uint y = index / gridSize.x;
    bool touchesAir = false;
    if (x > 0u) touchesAir = touchesAir || cellType[index - 1u] == AIR;
    if (x + 1u < gridSize.x) touchesAir = touchesAir || cellType[index + 1u] == AIR;
    if (y > 0u) touchesAir = touchesAir || cellType[index - gridSize.x] == AIR;
    if (y + 1u < gridSize.y) touchesAir = touchesAir || cellType[index + gridSize.x] == AIR;
    if (touchesAir) atomicOr(componentFlags[labels[index]], 1u);
}
