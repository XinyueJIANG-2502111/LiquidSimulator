#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 5) readonly buffer InputBuffer { dvec4 inputValue[]; };
layout(std430, binding = 6) writeonly buffer OutputBuffer { dvec4 outputValue[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uint elementCount;
uniform uint pressureControlEnabled;

shared double sumValue[256];
shared double maximumValue[256];
shared double countValue[256];

void main() {
    const uint localIndex = gl_LocalInvocationID.x;
    const uint index = gl_GlobalInvocationID.x;
    const bool solverActive = pressureControlEnabled == 0u ||
        uint(pressureControl[0] + 0.5) == 0u;
    const dvec4 value = solverActive && index < elementCount
        ? inputValue[index] : dvec4(0.0);
    sumValue[localIndex] = value.x;
    maximumValue[localIndex] = value.y;
    countValue[localIndex] = value.z;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            sumValue[localIndex] += sumValue[localIndex + stride];
            maximumValue[localIndex] = max(maximumValue[localIndex], maximumValue[localIndex + stride]);
            countValue[localIndex] += countValue[localIndex + stride];
        }
        barrier();
    }
    if (localIndex == 0u) {
        outputValue[gl_WorkGroupID.x] = dvec4(sumValue[0], maximumValue[0], countValue[0], 0.0);
    }
}
