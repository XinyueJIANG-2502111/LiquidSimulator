#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer FineResidual { float fineResidual[]; };
layout(std430, binding = 1) readonly buffer FineActiveMask { uint fineActive[]; };
layout(std430, binding = 2) readonly buffer CoarseActiveMask { uint coarseActive[]; };
layout(std430, binding = 3) writeonly buffer CoarseRightHandSide { float coarseRightHandSide[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uvec2 fineSize;
uniform uvec2 coarseSize;
uniform uint pressureControlEnabled;

void main() {
    const uint coarseIndex = gl_GlobalInvocationID.x;
    if (coarseIndex >= coarseSize.x * coarseSize.y) return;
    if (pressureControlEnabled != 0u && uint(pressureControl[0] + 0.5) != 0u) return;
    if (coarseActive[coarseIndex] == 0u) {
        coarseRightHandSide[coarseIndex] = 0.0;
        return;
    }
    const uvec2 coarseCell = uvec2(coarseIndex % coarseSize.x, coarseIndex / coarseSize.x);
    const uvec2 fineOrigin = coarseCell * 2u;
    float sum = 0.0;
    for (uint oy = 0u; oy < 2u; ++oy) {
        for (uint ox = 0u; ox < 2u; ++ox) {
            const uvec2 fineCell = fineOrigin + uvec2(ox, oy);
            if (fineCell.x >= fineSize.x || fineCell.y >= fineSize.y) continue;
            const uint fineIndex = fineCell.y * fineSize.x + fineCell.x;
            if (fineActive[fineIndex] != 0u) sum += fineResidual[fineIndex];
        }
    }
    coarseRightHandSide[coarseIndex] = sum;
}
