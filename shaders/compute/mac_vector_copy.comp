#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputVector { double inputValue[]; };
layout(std430, binding = 1) writeonly buffer OutputVector { double outputValue[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uint elementCount;
uniform uint pressureControlEnabled;
uniform uint clearOutput;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index < elementCount &&
        (pressureControlEnabled == 0u || uint(pressureControl[0] + 0.5) == 0u)) {
        outputValue[index] = clearOutput != 0u ? 0.0 : inputValue[index];
    }
}
