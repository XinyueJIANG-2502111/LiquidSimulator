#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer PhiBuffer { float phi[]; };
layout(std430, binding = 1) readonly buffer SolidMaskBuffer { uint solidMask[]; };
layout(std430, binding = 2) buffer AreaBuffer { uint areaData[]; };

uniform uvec2 gridSize;
uniform vec2 cellSize;

void main() {
    uvec2 cell = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(cell, gridSize))) return;
    uint index = cell.y * gridSize.x + cell.x;
    if (solidMask[index] != 0u) return;
    float value = phi[index];
    if (isnan(value) || isinf(value)) {
        atomicAdd(areaData[2], 1u);
        return;
    }
    float coverage = clamp(0.5 - value /
        (2.0 * min(cellSize.x, cellSize.y)), 0.0, 1.0);
    atomicAdd(areaData[0], uint(round(coverage * 65535.0)));
    if (value < 0.0) atomicAdd(areaData[1], 1u);
}
