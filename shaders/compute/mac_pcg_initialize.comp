#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 3) readonly buffer DivergenceBuffer { float divergence[]; };
layout(std430, binding = 4) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 5) readonly buffer ApBuffer { double matrixPressure[]; };
layout(std430, binding = 6) writeonly buffer ResidualBuffer { double residual[]; };
layout(std430, binding = 7) writeonly buffer PreconditionedBuffer { double preconditioned[]; };
layout(std430, binding = 8) writeonly buffer DirectionBuffer { double direction[]; };

uniform uvec2 gridSize;
uniform vec2 cellSize;
uniform double rhsScale;

const uint FLUID = 0u;
const uint AIR = 1u;

void addDiagonal(uvec2 neighbor, double coefficient, inout double diagonal) {
    const uint index = neighbor.y * gridSize.x + neighbor.x;
    if (cellType[index] == FLUID || cellType[index] == AIR) diagonal += coefficient;
}

void main() {
    const uvec2 cell = gl_GlobalInvocationID.xy;
    if (cell.x >= gridSize.x || cell.y >= gridSize.y) return;
    const uint index = cell.y * gridSize.x + cell.x;
    if (cellType[index] != FLUID) {
        residual[index] = 0.0;
        preconditioned[index] = 0.0;
        direction[index] = 0.0;
        return;
    }
    const double inverseDx2 = 1.0 / (double(cellSize.x) * double(cellSize.x));
    const double inverseDy2 = 1.0 / (double(cellSize.y) * double(cellSize.y));
    double diagonal = 0.0;
    if (cell.x > 0u) addDiagonal(cell - uvec2(1u, 0u), inverseDx2, diagonal);
    if (cell.x + 1u < gridSize.x) addDiagonal(cell + uvec2(1u, 0u), inverseDx2, diagonal);
    if (cell.y > 0u) addDiagonal(cell - uvec2(0u, 1u), inverseDy2, diagonal);
    if (cell.y + 1u < gridSize.y) addDiagonal(cell + uvec2(0u, 1u), inverseDy2, diagonal);
    const double value = -rhsScale * double(divergence[index]) - matrixPressure[index];
    const double z = diagonal > 0.0 ? value / diagonal : 0.0;
    residual[index] = value;
    preconditioned[index] = z;
    direction[index] = z;
}
