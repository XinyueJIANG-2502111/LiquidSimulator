#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer HorizontalVelocityBuffer { float u[]; };
layout(std430, binding = 1) readonly buffer VerticalVelocityBuffer { float v[]; };
layout(std430, binding = 2) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 3) readonly buffer PhiSourceBuffer { float phiSource[]; };
layout(std430, binding = 4) readonly buffer ConfidenceSourceBuffer { uint confidenceSource[]; };
layout(std430, binding = 5) writeonly buffer PhiTargetBuffer { float phiTarget[]; };
layout(std430, binding = 6) writeonly buffer ConfidenceTargetBuffer { uint confidenceTarget[]; };
layout(std430, binding = 7) buffer DiagnosticBuffer { uint diagnostic[]; };

uniform uvec2 gridSize;
uniform vec2 cellSize;
uniform float timeStep;
uniform uint writeDiagnostics;

const uint SOLID = 2u;

float sampleU(vec2 position) {
    vec2 q = clamp(position / cellSize - vec2(0.0, 0.5), vec2(0.0),
        vec2(float(gridSize.x), float(gridSize.y - 1u)));
    uvec2 lo = uvec2(floor(q));
    uvec2 hi = min(lo + uvec2(1u), uvec2(gridSize.x, gridSize.y - 1u));
    vec2 f = q - vec2(lo);
    uint stride = gridSize.x + 1u;
    float a = mix(u[lo.y * stride + lo.x], u[lo.y * stride + hi.x], f.x);
    float b = mix(u[hi.y * stride + lo.x], u[hi.y * stride + hi.x], f.x);
    return mix(a, b, f.y);
}

float sampleV(vec2 position) {
    vec2 q = clamp(position / cellSize - vec2(0.5, 0.0), vec2(0.0),
        vec2(float(gridSize.x - 1u), float(gridSize.y)));
    uvec2 lo = uvec2(floor(q));
    uvec2 hi = min(lo + uvec2(1u), uvec2(gridSize.x - 1u, gridSize.y));
    vec2 f = q - vec2(lo);
    float a = mix(v[lo.y * gridSize.x + lo.x], v[lo.y * gridSize.x + hi.x], f.x);
    float b = mix(v[hi.y * gridSize.x + lo.x], v[hi.y * gridSize.x + hi.x], f.x);
    return mix(a, b, f.y);
}

vec2 velocity(vec2 position) { return vec2(sampleU(position), sampleV(position)); }

bool finiteVector(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float samplePhi(vec2 position, out bool reliable) {
    vec2 q = clamp(position / cellSize - vec2(0.5), vec2(0.0), vec2(gridSize - uvec2(1u)));
    uvec2 lo = uvec2(floor(q));
    uvec2 hi = min(lo + uvec2(1u), gridSize - uvec2(1u));
    vec2 f = q - vec2(lo);
    uint i00 = lo.y * gridSize.x + lo.x;
    uint i10 = lo.y * gridSize.x + hi.x;
    uint i01 = hi.y * gridSize.x + lo.x;
    uint i11 = hi.y * gridSize.x + hi.x;
    reliable = confidenceSource[i00] != 0u && confidenceSource[i10] != 0u &&
        confidenceSource[i01] != 0u && confidenceSource[i11] != 0u;
    float a = mix(phiSource[i00], phiSource[i10], f.x);
    float b = mix(phiSource[i01], phiSource[i11], f.x);
    return mix(a, b, f.y);
}

void main() {
    uvec2 cell = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(cell, gridSize))) return;
    uint index = cell.y * gridSize.x + cell.x;
    if (cellType[index] == SOLID) {
        phiTarget[index] = phiSource[index];
        confidenceTarget[index] = 0u;
        return;
    }
    vec2 position = (vec2(cell) + vec2(0.5)) * cellSize;
    vec2 firstVelocity = velocity(position);
    if (!finiteVector(firstVelocity)) {
        phiTarget[index] = phiSource[index];
        confidenceTarget[index] = 0u;
        if (writeDiagnostics != 0u) atomicAdd(diagnostic[18], 1u);
        return;
    }
    vec2 minimumPosition = vec2(0.5) * cellSize;
    vec2 maximumPosition = (vec2(gridSize) - vec2(0.5)) * cellSize;
    vec2 rawMiddle = position - 0.5 * timeStep * firstVelocity;
    vec2 middle = clamp(rawMiddle, minimumPosition, maximumPosition);
    vec2 middleVelocity = velocity(middle);
    if (!finiteVector(middleVelocity)) {
        phiTarget[index] = phiSource[index];
        confidenceTarget[index] = 0u;
        if (writeDiagnostics != 0u) atomicAdd(diagnostic[18], 1u);
        return;
    }
    vec2 rawSource = position - timeStep * middleVelocity;
    vec2 source = clamp(rawSource, minimumPosition, maximumPosition);
    if (writeDiagnostics != 0u &&
        (any(notEqual(rawMiddle, middle)) || any(notEqual(rawSource, source))))
        atomicAdd(diagnostic[15], 1u);
    uvec2 sourceCell = uvec2(clamp(floor(source / cellSize), vec2(0.0),
        vec2(gridSize - uvec2(1u))));
    if (writeDiagnostics != 0u &&
        cellType[sourceCell.y * gridSize.x + sourceCell.x] == SOLID)
        atomicAdd(diagnostic[16], 1u);
    bool reliable = false;
    float value = samplePhi(source, reliable);
    if (isnan(value) || isinf(value)) {
        value = phiSource[index];
        reliable = false;
        atomicAdd(diagnostic[0], 1u);
    }
    phiTarget[index] = value;
    confidenceTarget[index] = reliable ? 1u : 0u;
    if (writeDiagnostics != 0u && !reliable) atomicAdd(diagnostic[17], 1u);
}
