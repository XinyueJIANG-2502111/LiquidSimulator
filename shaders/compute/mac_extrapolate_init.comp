#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer HorizontalVelocityBuffer { float u[]; };
layout(std430, binding = 1) buffer VerticalVelocityBuffer { float v[]; };
layout(std430, binding = 2) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 3) writeonly buffer HorizontalValidBuffer { uint uValid[]; };
layout(std430, binding = 4) writeonly buffer VerticalValidBuffer { uint vValid[]; };

uniform uvec2 gridSize;

const uint FLUID = 0u;
const uint SOLID = 2u;

uint cellIndex(uvec2 cell) { return cell.y * gridSize.x + cell.x; }

void main() {
    const uvec2 face = gl_GlobalInvocationID.xy;
    if (face.y < gridSize.y && face.x <= gridSize.x) {
        const uint index = face.y * (gridSize.x + 1u) + face.x;
        const bool blocked = face.x == 0u || face.x == gridSize.x ||
            cellType[cellIndex(face - uvec2(face.x > 0u ? 1u : 0u, 0u))] == SOLID ||
            cellType[cellIndex(uvec2(min(face.x, gridSize.x - 1u), face.y))] == SOLID;
        const bool valid = !blocked &&
            (cellType[cellIndex(face - uvec2(1u, 0u))] == FLUID ||
             cellType[cellIndex(face)] == FLUID);
        uValid[index] = valid ? 1u : 0u;
        if (blocked || !valid) u[index] = 0.0;
    }
    if (face.x < gridSize.x && face.y <= gridSize.y) {
        const uint index = face.y * gridSize.x + face.x;
        const bool blocked = face.y == 0u || face.y == gridSize.y ||
            cellType[cellIndex(uvec2(face.x, face.y > 0u ? face.y - 1u : 0u))] == SOLID ||
            cellType[cellIndex(uvec2(face.x, min(face.y, gridSize.y - 1u)))] == SOLID;
        const bool valid = !blocked &&
            (cellType[cellIndex(face - uvec2(0u, 1u))] == FLUID ||
             cellType[cellIndex(face)] == FLUID);
        vValid[index] = valid ? 1u : 0u;
        if (blocked || !valid) v[index] = 0.0;
    }
}
