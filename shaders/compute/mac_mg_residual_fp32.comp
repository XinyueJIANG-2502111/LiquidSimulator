#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Correction { float correction[]; };
layout(std430, binding = 1) readonly buffer RightHandSide { float rightHandSide[]; };
layout(std430, binding = 2) readonly buffer Diagonal { double diagonal[]; };
layout(std430, binding = 3) readonly buffer Weights { dvec4 weights[]; };
layout(std430, binding = 4) readonly buffer ActiveMask { uint activeMask[]; };
layout(std430, binding = 5) writeonly buffer Residual { float residual[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uvec2 gridSize;
uniform uint pressureControlEnabled;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    const uint count = gridSize.x * gridSize.y;
    if (index >= count) return;
    if (pressureControlEnabled != 0u && uint(pressureControl[0] + 0.5) != 0u) return;
    if (activeMask[index] == 0u) {
        residual[index] = 0.0;
        return;
    }
    const uint x = index % gridSize.x;
    const uint y = index / gridSize.x;
    const vec4 w = vec4(weights[index]);
    float matrixValue = float(diagonal[index]) * correction[index];
    if (x > 0u) matrixValue -= w.x * correction[index - 1u];
    if (x + 1u < gridSize.x) matrixValue -= w.y * correction[index + 1u];
    if (y > 0u) matrixValue -= w.z * correction[index - gridSize.x];
    if (y + 1u < gridSize.y) matrixValue -= w.w * correction[index + gridSize.x];
    residual[index] = rightHandSide[index] - matrixValue;
}
