#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer FineCorrection { float fineCorrection[]; };
layout(std430, binding = 1) readonly buffer FineActiveMask { uint fineActive[]; };
layout(std430, binding = 2) readonly buffer CoarseCorrection { float coarseCorrection[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uvec2 fineSize;
uniform uvec2 coarseSize;
uniform uint pressureControlEnabled;

void main() {
    const uint fineIndex = gl_GlobalInvocationID.x;
    if (fineIndex >= fineSize.x * fineSize.y || fineActive[fineIndex] == 0u ||
        (pressureControlEnabled != 0u && uint(pressureControl[0] + 0.5) != 0u)) return;
    const uvec2 fineCell = uvec2(fineIndex % fineSize.x, fineIndex / fineSize.x);
    const uvec2 coarseCell = fineCell / 2u;
    const uint coarseIndex = coarseCell.y * coarseSize.x + coarseCell.x;
    fineCorrection[fineIndex] += coarseCorrection[coarseIndex];
}
