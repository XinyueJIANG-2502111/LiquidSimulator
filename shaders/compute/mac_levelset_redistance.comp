#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer PhiSourceBuffer { float phiSource[]; };
layout(std430, binding = 1) readonly buffer ConfidenceSourceBuffer { uint confidenceSource[]; };
layout(std430, binding = 2) writeonly buffer PhiTargetBuffer { float phiTarget[]; };
layout(std430, binding = 3) writeonly buffer ConfidenceTargetBuffer { uint confidenceTarget[]; };
layout(std430, binding = 4) writeonly buffer NarrowBandBuffer { uint narrowBand[]; };
layout(std430, binding = 5) readonly buffer SolidMaskBuffer { uint solidMask[]; };
layout(std430, binding = 7) buffer DiagnosticBuffer { uint diagnostic[]; };

uniform uvec2 gridSize;
uniform vec2 cellSize;
uniform float bandWidth;
uniform uint preserveInterface;

float pointSegmentDistance(vec2 p, vec2 a, vec2 b) {
    vec2 d = b - a;
    float d2 = dot(d, d);
    if (d2 <= 1.0e-20) return length(p - a);
    float t = clamp(dot(p - a, d) / d2, 0.0, 1.0);
    return length(p - (a + t * d));
}

bool crossing(float a, float b) {
    return (a <= 0.0 && b > 0.0) || (a > 0.0 && b <= 0.0);
}

bool reliableCrossing(uint a, uint b) {
    return confidenceSource[a] != 0u && confidenceSource[b] != 0u &&
        !isnan(phiSource[a]) && !isinf(phiSource[a]) &&
        !isnan(phiSource[b]) && !isinf(phiSource[b]) &&
        crossing(phiSource[a], phiSource[b]);
}

vec2 edgePoint(ivec2 base, int edge, float a, float b) {
    float t = abs(a) / max(abs(a) + abs(b), 1.0e-20);
    vec2 p0;
    vec2 p1;
    if (edge == 0) { p0 = vec2(base) + vec2(0.5, 0.5); p1 = vec2(base) + vec2(1.5, 0.5); }
    else if (edge == 1) { p0 = vec2(base) + vec2(1.5, 0.5); p1 = vec2(base) + vec2(1.5, 1.5); }
    else if (edge == 2) { p0 = vec2(base) + vec2(1.5, 1.5); p1 = vec2(base) + vec2(0.5, 1.5); }
    else { p0 = vec2(base) + vec2(0.5, 1.5); p1 = vec2(base) + vec2(0.5, 0.5); }
    return mix(p0 * cellSize, p1 * cellSize, t);
}

void main() {
    uvec2 cell = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(cell, gridSize))) return;
    uint index = cell.y * gridSize.x + cell.x;
    if (solidMask[index] != 0u) {
        phiTarget[index] = phiSource[index];
        confidenceTarget[index] = 0u;
        narrowBand[index] = 0u;
        return;
    }
    if (preserveInterface != 0u) {
        bool adjacent = false;
        if (cell.x > 0u) adjacent = adjacent || reliableCrossing(index, index - 1u);
        if (cell.x + 1u < gridSize.x)
            adjacent = adjacent || reliableCrossing(index, index + 1u);
        if (cell.y > 0u)
            adjacent = adjacent || reliableCrossing(index, index - gridSize.x);
        if (cell.y + 1u < gridSize.y)
            adjacent = adjacent || reliableCrossing(index, index + gridSize.x);
        if (adjacent) {
            phiTarget[index] = phiSource[index];
            confidenceTarget[index] = 1u;
            narrowBand[index] = 1u;
            atomicAdd(diagnostic[31], 1u);
            return;
        }
    }
    if (abs(phiSource[index]) > bandWidth + 2.0 * max(cellSize.x, cellSize.y)) {
        phiTarget[index] = phiSource[index] < 0.0 ? -bandWidth : bandWidth;
        confidenceTarget[index] = 0u;
        narrowBand[index] = 0u;
        return;
    }
    vec2 p = (vec2(cell) + vec2(0.5)) * cellSize;
    int radius = int(clamp(ceil(bandWidth / min(cellSize.x, cellSize.y)) + 1.0, 2.0, 8.0));
    float best = 3.402823466e+38;
    for (int oy = -radius; oy <= radius; ++oy) {
        for (int ox = -radius; ox <= radius; ++ox) {
            ivec2 b = ivec2(cell) + ivec2(ox, oy);
            if (b.x < 0 || b.y < 0 || b.x + 1 >= int(gridSize.x) || b.y + 1 >= int(gridSize.y)) continue;
            uint i00 = uint(b.y) * gridSize.x + uint(b.x);
            uint i10 = i00 + 1u;
            uint i01 = i00 + gridSize.x;
            uint i11 = i01 + 1u;
            float q[4] = float[4](phiSource[i00], phiSource[i10], phiSource[i11], phiSource[i01]);
            vec2 hit[4];
            int count = 0;
            if (crossing(q[0], q[1])) hit[count++] = edgePoint(b, 0, q[0], q[1]);
            if (crossing(q[1], q[2])) hit[count++] = edgePoint(b, 1, q[1], q[2]);
            if (crossing(q[2], q[3])) hit[count++] = edgePoint(b, 2, q[2], q[3]);
            if (crossing(q[3], q[0])) hit[count++] = edgePoint(b, 3, q[3], q[0]);
            if (count == 2) best = min(best, pointSegmentDistance(p, hit[0], hit[1]));
            else if (count == 4) {
                best = min(best, pointSegmentDistance(p, hit[0], hit[1]));
                best = min(best, pointSegmentDistance(p, hit[2], hit[3]));
            }
        }
    }
    if (best < 3.0e+38 && best <= bandWidth) {
        phiTarget[index] = phiSource[index] < 0.0 ? -best : best;
        confidenceTarget[index] = 1u;
        narrowBand[index] = 1u;
    } else {
        phiTarget[index] = phiSource[index] < 0.0 ? -bandWidth : bandWidth;
        confidenceTarget[index] = 0u;
        narrowBand[index] = 0u;
        if (abs(phiSource[index]) <= bandWidth && best >= 3.0e+38)
            atomicAdd(diagnostic[0], 1u);
    }
}
