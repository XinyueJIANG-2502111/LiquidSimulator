#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer PhiBuffer { float phi[]; };
layout(std430, binding = 1) readonly buffer ConfidenceBuffer { uint confidence[]; };
layout(std430, binding = 2) writeonly buffer LabelBuffer { uint label[]; };
uniform uint elementCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= elementCount) return;
    label[i] = phi[i] < 0.0 ? i + 1u : 0u;
}
