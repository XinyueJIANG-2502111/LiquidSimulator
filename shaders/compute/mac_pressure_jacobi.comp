#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 2) readonly buffer PressureInputBuffer { double pressureIn[]; };
layout(std430, binding = 3) readonly buffer DivergenceBuffer { float divergence[]; };
layout(std430, binding = 4) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 5) writeonly buffer PressureOutputBuffer { double pressureOut[]; };

uniform uvec2 gridSize;
uniform vec2 cellSize;
uniform double rhsScale;
uniform double relaxationFactor;

const uint FLUID = 0u;
const uint AIR = 1u;

void addNeighbor(
    uvec2 neighbor,
    double coefficient,
    inout double neighborSum,
    inout double diagonal) {
    const uint index = neighbor.y * gridSize.x + neighbor.x;
    if (cellType[index] == FLUID) {
        neighborSum += coefficient * pressureIn[index];
        diagonal += coefficient;
    } else if (cellType[index] == AIR) {
        diagonal += coefficient;
    }
}

void main() {
    const uvec2 cell = gl_GlobalInvocationID.xy;
    if (cell.x >= gridSize.x || cell.y >= gridSize.y) return;
    const uint index = cell.y * gridSize.x + cell.x;
    if (cellType[index] != FLUID) {
        pressureOut[index] = 0.0;
        return;
    }

    const double inverseDx2 = 1.0 / (double(cellSize.x) * double(cellSize.x));
    const double inverseDy2 = 1.0 / (double(cellSize.y) * double(cellSize.y));
    double neighborSum = 0.0;
    double diagonal = 0.0;
    if (cell.x > 0u) addNeighbor(cell - uvec2(1u, 0u), inverseDx2, neighborSum, diagonal);
    if (cell.x + 1u < gridSize.x) addNeighbor(cell + uvec2(1u, 0u), inverseDx2, neighborSum, diagonal);
    if (cell.y > 0u) addNeighbor(cell - uvec2(0u, 1u), inverseDy2, neighborSum, diagonal);
    if (cell.y + 1u < gridSize.y) addNeighbor(cell + uvec2(0u, 1u), inverseDy2, neighborSum, diagonal);
    if (diagonal > 0.0) {
        const double candidate = (neighborSum - rhsScale * double(divergence[index])) / diagonal;
        pressureOut[index] = mix(pressureIn[index], candidate, relaxationFactor);
    } else {
        pressureOut[index] = 0.0;
    }
}
