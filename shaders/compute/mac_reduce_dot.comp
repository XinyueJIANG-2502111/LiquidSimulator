#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 4) readonly buffer CellTypeBuffer { uint cellType[]; };
layout(std430, binding = 5) readonly buffer LeftBuffer { double leftValue[]; };
layout(std430, binding = 6) readonly buffer RightBuffer { double rightValue[]; };
layout(std430, binding = 7) writeonly buffer PartialBuffer { dvec4 partial[]; };
layout(std430, binding = 10) readonly buffer PressureControl { double pressureControl[]; };

uniform uint elementCount;
uniform uint pressureControlEnabled;

shared double products[256];

const uint FLUID = 0u;

void main() {
    const uint localIndex = gl_LocalInvocationID.x;
    const uint index = gl_GlobalInvocationID.x;
    const bool solverActive = pressureControlEnabled == 0u ||
        uint(pressureControl[0] + 0.5) == 0u;
    products[localIndex] = solverActive && index < elementCount && cellType[index] == FLUID
        ? leftValue[index] * rightValue[index] : 0.0;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) products[localIndex] += products[localIndex + stride];
        barrier();
    }
    if (localIndex == 0u) {
        partial[gl_WorkGroupID.x] = dvec4(products[0], 0.0, 0.0, 0.0);
    }
}
